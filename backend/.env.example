# --- the coin (pump.fun mint of $LABRAT — a normal coin paired with SOL) ---
TOKEN_MINT=
# creator wallet key (bs58 from Phantom/Solflare, or a JSON byte array). Leave the
# placeholder to run in WATCH mode (dry trials, nothing moves). Must be the coin's creator.
WALLET_PRIVATE_KEY=PASTE_PRIVATE_KEY_HERE

# --- the brain: Jev, TypeSafe AI's System One model (console.typesafe.ai/settings/keys) ---
# Without a key the odds are a fair coin (50/50, labelled `instinct`) and the page says so.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000

# --- engine ---
TRIAL_INTERVAL_SEC=180
MIN_CLAIM_USD=0.1
MIN_BUY_USD=0.25
GAS_RESERVE_SOL=0.01
MIN_GAS_SOL=0.003
SLIPPAGE_PCT=5
BLESS_TOP_N=100
SCHEDULER_ENABLED=true
DRY_RUN=false
POLL_SEC=10

# --- infra ---
PORT=4000
DATABASE_URL=postgres://localhost:5432/labrat
RPC_URL=https://api.mainnet-beta.solana.com

# --- brand ---
BRAND_NAME=LABRAT
SITE_URL=http://localhost:4000
BRAND_TWITTER=
BRAND_TELEGRAM=
